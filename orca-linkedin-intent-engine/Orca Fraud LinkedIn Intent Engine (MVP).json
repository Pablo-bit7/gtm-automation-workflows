    {
      "parameters": {
        "jsCode": "// DATA\nconst inputData = $('Edit Fields').item.json;\nconst companyClass = $('AI Agent').item.json.output;\nconst personaClass = $('AI Agent1').item.json.output;\n\n// --- 12. SIGNAL SCORING ---\nlet signal_score = 0;\nconst signal_map = { 'Like': 1, 'Comment': 3, 'Repost': 4 };\nsignal_score = signal_map[inputData.engagement] || 0;\n\n// --- 13. COMPANY SCORING ---\nlet company_score = 0;\nif (companyClass.category !== 'Not Relevant') {\n    company_score += 5; // Fintech identified\n    company_score += 3; // Category detected\n}\nif (personaClass.fraud_exposure === 'High') {\n    company_score += 4;\n}\n\n// --- 14. TOTAL LEAD SCORE ---\nconst persona_score = parseInt(personaClass.persona_score) || 0;\nconst total_score = signal_score + company_score + persona_score;\n\n// --- 15. LEAD TIER CLASSIFICATION ---\nlet tier = \"Tier 3\";\nif (total_score >= 12) tier = \"Tier 1\";\nelse if (total_score >= 8) tier = \"Tier 2\";\nelse if (total_score >= 5) tier = \"Tier 3\";\n\n// --- PAYLOAD ---\nreturn {\n  // Edit Fields\n  name: inputData.name,\n  linkedin_profile: inputData.profile_url,\n  title: inputData.title,\n  company: inputData.company,\n  industry: inputData.industry,\n  engagement: inputData.engagement || 'None',\n  \n  // AI Agents\n  company_category: companyClass.category,\n  fraud_exposure: personaClass.fraud_exposure,\n  persona_type: personaClass.persona_type,\n  fraud_insight: personaClass.fraud_insight,\n  \n  // Scoring Results\n  signal_score: signal_score,\n  persona_score: persona_score,\n  company_score: company_score,\n  total_score: total_score,\n  tier: tier\n};"
      },
