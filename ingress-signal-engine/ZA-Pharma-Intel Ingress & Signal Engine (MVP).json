      "parameters": {
        "jsCode": "return $input.all()\n  .filter(item => item.json.formMode !== \"test\")\n  .map(item => {\n\n    delete item.json.formMode;\n\n    const date = new Date(item.json.submittedAt);\n\n    item.json.submittedAt = date.toLocaleString(\"en-ZA\", {\n      timeZone: \"Africa/Johannesburg\",\n      year: \"numeric\",\n      month: \"2-digit\",\n      day: \"2-digit\",\n      hour: \"2-digit\",\n      minute: \"2-digit\",\n      hour12: false\n    }) + \" SAST\";\n\n    return item;\n  });\n"
      },
